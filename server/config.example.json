{
  "devices": {
    "xiaomi-gateway": {
      "secret_base64": "REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES_ENCODED_AS_BASE64"
    }
  },
  "tls": {
    "certificate": "server/tls/receiver-cert.pem",
    "private_key": "server/tls/receiver-key.pem",
    "certificate_pin_sha256_base64": "BASE64_SHA256_OF_DER_CERTIFICATE",
    "lan_ip": "192.168.1.10"
  },
  "api_clients": {
    "automation": {
      "token_sha256": "SHA256_HEX_OF_RANDOM_BEARER_TOKEN",
      "scopes": [
        "messages:read",
        "messages:send",
        "otp:claim",
        "pairing:create"
      ],
      "allowedDeviceIds": [
        "xiaomi-gateway"
      ]
    }
  },
  "notifications": {
    "channels": [
      {
        "id": "iphone-bark",
        "name": "Bark",
        "type": "BARK",
        "server": "https://api.day.app",
        "device_key": "REPLACE_WITH_BARK_DEVICE_KEY",
        "group": "CA Connection",
        "sound": "",
        "level": "active",
        "call": false
      },
      {
        "id": "home-webhook",
        "name": "Home Webhook",
        "type": "WEBHOOK",
        "method": "POST",
        "url": "https://example.com/hooks/caconnection",
        "headers": {
          "Authorization": "Bearer REPLACE_WITH_TOKEN"
        },
        "query": {},
        "content_type": "application/json",
        "body_template": "{\"event\":\"{{event.type}}\",\"eventId\":\"{{event.id}}\",\"device\":\"{{device.id}}\",\"sender\":\"{{data.from}}\",\"name\":\"{{data.contactName}}\",\"message\":\"{{data.body}}\",\"timestamp\":\"{{event.timestamp}}\"}",
        "timeout_ms": 10000
      }
    ]
  },
  "server": {
    "retention_days": 30,
    "otp_max_age_seconds": 600,
    "ingest_requests_per_minute": 120,
    "device_requests_per_minute": 120,
    "api_auth_requests_per_minute": 120,
    "api_requests_per_minute": 60,
    "pairing_create_requests_per_minute": 20,
    "pairing_claim_requests_per_minute": 20,
    "pairing_public_endpoint": "https://gateway.example.com",
    "pairing_certificate_pin_sha256_base64": "",
    "max_concurrent_requests": 32,
    "trust_proxy_headers": false
  }
}
