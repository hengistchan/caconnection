<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="14dp"
        android:paddingEnd="10dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/page_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:text="@string/home_title"
                android:textColor="?attr/colorOnSurface"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/page_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/home_subtitle"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/language_button"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/language"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="@string/language_short"
            android:textAllCaps="false"
            android:textColor="@color/brand_blue"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/header_refresh_button"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/refresh"
            android:minWidth="0dp"
            android:padding="0dp"
            app:icon="@drawable/ic_refresh"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconTint="@color/icon_secondary" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/page_home"
            style="@style/AppPage"
            android:overScrollMode="never"
            android:scrollbars="none">
            <LinearLayout
                android:id="@+id/home_content"
                style="@style/AppPageContent" />
        </ScrollView>

        <ScrollView
            android:id="@+id/page_messages"
            style="@style/AppPage"
            android:overScrollMode="never"
            android:scrollbars="none"
            android:visibility="gone">
            <LinearLayout
                android:id="@+id/messages_content"
                style="@style/AppPageContent" />
        </ScrollView>

        <ScrollView
            android:id="@+id/page_activity"
            style="@style/AppPage"
            android:overScrollMode="never"
            android:scrollbars="none"
            android:visibility="gone">
            <LinearLayout
                android:id="@+id/activity_content"
                style="@style/AppPageContent" />
        </ScrollView>

        <ScrollView
            android:id="@+id/page_settings"
            style="@style/AppPage"
            android:overScrollMode="never"
            android:scrollbars="none"
            android:visibility="gone">
            <LinearLayout
                android:id="@+id/settings_content"
                style="@style/AppPageContent" />
        </ScrollView>
    </FrameLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/navigation_background"
        android:elevation="12dp"
        android:minHeight="72dp"
        app:itemActiveIndicatorStyle="@style/BottomNavIndicator"
        app:itemIconSize="25dp"
        app:itemIconTint="@color/bottom_nav_item_selector"
        app:itemTextColor="@color/bottom_nav_item_selector"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/main_navigation" />
</LinearLayout>
